FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# Copy root pom
COPY pom.xml .

# Copy ALL module pom.xml files so Maven can resolve the parent structure
COPY discovery-server/pom.xml discovery-server/
COPY user-service/pom.xml user-service/
COPY ride-service/pom.xml ride-service/
COPY payment-service/pom.xml payment-service/
COPY api-gateway/pom.xml api-gateway/

# Copy only discovery-server source
COPY discovery-server/src discovery-server/src

# Build only discovery-server
RUN mvn -pl discovery-server -am clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/discovery-server/target/*.jar app.jar
EXPOSE 8761
ENTRYPOINT ["java", "-jar", "app.jar"]